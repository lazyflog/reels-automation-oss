# Copy to .env and fill in. Never commit .env.
# Optional features that touch third-party platforms are OFF by default —
# read docs/LEGAL.md before turning any of them on.

# ── Database / queue ───────────────────────────────────
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/reels
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:password@postgres:5432/reels
REDIS_URL=redis://redis:6379/0

# ── Content ────────────────────────────────────────────
# Language for the generated script, caption and cover title (e.g. English, Korean, Japanese, Chinese)
CONTENT_LANGUAGE=English
# Optional audience description used in the script prompt, e.g. "busy parents in their 30s"
TARGET_AUDIENCE=
# Optional text appended to every caption, e.g. an affiliate / sponsorship disclosure
CAPTION_DISCLOSURE=

# ── OpenAI (required: script + caption generation) ─────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# ── ElevenLabs (required: TTS) ─────────────────────────
# Commercial use of generated audio requires a paid ElevenLabs plan.
ELEVENLABS_API_KEY=
# Fallback voice when a job has no voice selected (ElevenLabs premade voice "Rachel")
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
TTS_PROVIDER=elevenlabs

# ── Google Gemini (optional: video analysis; skipped if empty) ──
# On the free tier, Google may use inputs/outputs to improve products and humans may review them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# ── Instagram (optional: Reels upload via Instagram Login) ──
# Long-lived IG user token (60 days) — get it with: backend/scripts/instagram_setup.py exchange
INSTAGRAM_ACCESS_TOKEN=
# IG user ID — backend/scripts/instagram_setup.py me
INSTAGRAM_ACCOUNT_ID=
# Instagram app secret (token exchange / refresh)
INSTAGRAM_APP_SECRET=
# INSTAGRAM_GRAPH_BASE=https://graph.instagram.com
# INSTAGRAM_API_VERSION=v23.0
# Public HTTPS URL Meta uses to download the rendered video (e.g. an ngrok URL for local dev)
PUBLIC_BASE_URL=https://your-domain.com
# Optional random delay between approval and upload, in minutes (0 = immediately)
UPLOAD_DELAY_MIN_MINUTES=0
UPLOAD_DELAY_MAX_MINUTES=0

# ── Source import ──────────────────────────────────────
# Import videos by URL with yt-dlp. Only for videos you own or are licensed to use.
ENABLE_URL_IMPORT=true
# Max size of one uploaded source video (MB)
MAX_UPLOAD_MB=500

# ── Opt-in features (OFF by default — see docs/LEGAL.md) ──
# Xiaohongshu import via the optional xhs-downloader sidecar (`docker compose --profile xhs up -d`)
ENABLE_XHS_IMPORT=false
# XHS_DOWNLOADER_URL=http://xhs-downloader:5556

# Watermark / burned-in subtitle removal via the vmake.ai plugin
# (SDK installed separately — backend/plugins/vmake/README.md)
ENABLE_WATERMARK_REMOVAL=false
VMAKE_AK=
VMAKE_SK=
# VMAKE_SDK_DIR=./plugins/vmake

# Download BGM from a URL with yt-dlp
ENABLE_BGM_URL_DOWNLOAD=false

# NAVER CLOVA Voice as TTS provider / fallback
ENABLE_CLOVA_VOICE=false
CLOVA_CLIENT_ID=
CLOVA_CLIENT_SECRET=

# ── Misc ───────────────────────────────────────────────
TIMEZONE=UTC
TEMP_DIR=./temp
OUTPUT_DIR=./output
